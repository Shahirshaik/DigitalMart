# ──────────────────────────────────────────────────────────────
# Digital Mart — Environment Variables
# Copy this file to .env.local and fill in your Supabase values
# ──────────────────────────────────────────────────────────────

# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — only used server-side (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Manual UPI payment collection (low-volume launch phase — see SETUP.md)
NEXT_PUBLIC_UPI_ID=your-upi-id@bank
NEXT_PUBLIC_UPI_PAYEE_NAME=Your Name

# Optional — shared secret checked by /api/cron/auto-release. Set the same
# value here and in Vercel's project settings to stop the endpoint from
# being triggered by anyone who finds the URL. Safe to leave unset; the
# route just skips the check (the RPC it calls is idempotent either way).
CRON_SECRET=

# Public site URL used to build shareable referral links (defaults to the
# production Vercel URL if unset).
NEXT_PUBLIC_SITE_URL=https://digitalmart-tau.vercel.app

# Meta Developer App (developers.facebook.com) — required for /admin/social
# (Instagram/Facebook auto-posting). See SETUP.md for the full walkthrough.
META_APP_ID=
META_APP_SECRET=
